# ─────────────────────────────────────────────────────────────────────────
# SHTAPM — environment template.  Copy to .env and fill values.
# NEVER commit a real .env (see .gitignore).  Variable NAMES are frozen per
# TRD §02.7.  Defaults below are non-secret and safe for local offline dev;
# secrets are intentionally BLANK and must be set.
# ─────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
# POSTGRES_HOST: "db" when the backend runs as a Compose service (service name);
# "localhost" when it runs as a host process against the published port.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=shtapm
POSTGRES_USER=shtapm
POSTGRES_PASSWORD=                 # REQUIRED — set a local dev password
#
# DATABASE_URL is OPTIONAL. Leave it unset and the backend composes it from the
# five variables above, so the password cannot drift between the container and
# the app. Set it only to point somewhere else entirely (a managed database, or
# sqlite:// in tests); a value here overrides the composed one.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
#
# NOTE: POSTGRES_PASSWORD only takes effect when the database volume is FIRST
# created. Changing it later does not change the password of an existing
# `db_data` volume — the role keeps whatever it was initialised with. To change
# it on a live database without losing data:
#   docker compose exec db psql -U <user> -d <db> -c "ALTER USER <user> WITH PASSWORD '<new>';"

# ── Channel provenance (declaration, NOT inferred from telemetry) ──
# Which frozen channels are believed to be backed by a physically connected
# sensor. The telemetry contract carries six plain floats and no provenance
# marker, so a placeholder constant is byte-identical to a real reading — the
# backend cannot infer this and must be told.
#
# Values: live | placeholder. Any channel omitted is reported as "unknown",
# which is NOT the same claim as "placeholder" and must not be rendered as one.
#
# This is only half of the story: the API reports a channel as live only when
# this declaration AND the `sensors` registry (seeded by app.core.seed) agree.
# Declaring a channel live with no registered part degrades it to unknown.
#
# Current documented bench state (edge/main.py _DEFAULT_CHANNEL_SPECS, D028):
SHTAPM_CHANNEL_SOURCES=temperature=live,humidity=live,vibration=live,pressure=placeholder,gas=placeholder,current=placeholder

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET_KEY=                    # REQUIRED — long random string; never reuse
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
PASSWORD_BCRYPT_ROUNDS=12

# ── MQTT ──────────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=                     # empty = anonymous (DEV ONLY; P4 adds creds, PRD App E)
MQTT_PASSWORD=
MQTT_TLS_ENABLED=false

# ── Backend ───────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002                  # host port (container stays 8000); avoids local 8000 conflict
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
WS_MAX_CLIENTS=50

# ── Frontend (Vite — VITE_ prefix is exposed to the client) ──
VITE_API_BASE_URL=http://localhost:8002
VITE_WS_URL=ws://localhost:8002/ws
VITE_DEMO_MODE=false
VITE_AURORA_MOTION=full            # full | reduced | off
VITE_REDUCE_TRANSPARENCY_DEFAULT=false

# ── Edge node ─────────────────────────────────────────────
DEVICE_ID=pump-01
SAMPLE_RATE_HZ=1
WINDOW_SIZE=30
P2_FIT_WINDOW_COUNT=                # REQUIRED — how many clean live windows LiveP2Monitor
                                     # bootstrap-fits ConsistencyProvider on before monitoring
                                     # begins (edge/pipeline/monitor.py). Arbitrary corpus size,
                                     # NOT a validated calibration value (U07 still open) — must
                                     # be > 1 or `c` collapses to a binary 0.0/1.0 signal even on
                                     # clean data (see edge/pipeline/monitor.py's docstring).
MODEL_DIR=./models
THRESHOLD_CONFIG_PATH=./config/thresholds.yaml
EDGE_MQTT_HOST=mosquitto
EDGE_MQTT_PORT=1883
FALLBACK_REPLAY_PATH=./data/replay/session.jsonl
SHTAPM_FAKE_SIGNAL_MODE=realistic   # recommended for local dev/E2E; unset = flat constants

# ── Ops ───────────────────────────────────────────────────
ENVIRONMENT=development
SENTRY_DSN=                        # optional
