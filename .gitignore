.DS_Store
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/
.vscode/

# Trained model artifacts (generated in P2/P3 — never committed)
edge/models/*.pkl
edge/models/*.pt
edge/models/*.zip
edge/models/*.onnx

# Recorded/replay session data (generated; can be large)
data/replay/

# Broker runtime state
infra/mosquitto/data/
infra/mosquitto/log/

# Optional corporate/proxy root CAs (TLS-inspected networks) — never commit certs
backend/certs/*
!backend/certs/.gitkeep

# Logs
*.log
